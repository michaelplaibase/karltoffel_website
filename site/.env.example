# Kopiér til .env og udfyld. Start med: npm start  (bruger --env-file=.env)

# Server
PORT=3000
NODE_ENV=production

# Prislogik --------------------------------------------------------------
# Er WorkMaker-enhedspriserne inkl. moms? Standard: nej (vi laegger 25% paa).
# BEKRAEFT dette med Thomas foer launch - det flytter alle kundevendte priser.
PRICES_INCLUDE_MOMS=false
MOMS_RATE=0.25

# Adresseudbyder ---------------------------------------------------------
# 'dawa' = gratis, token-loes, live til 01.10.2026 (standard).
# 'adressevaelger' = Klimadatastyrelsens afloeser (kraever token, aabner naar DAWA lukker).
ADDRESS_PROVIDER=dawa
ADRESSEVAELGER_TOKEN=

# Lead-modtagelse --------------------------------------------------------
# Hvor gemmes lead-filer (JSON pr. lead). Default: data/leads under projektet.
LEAD_STORE_DIR=
# Mailadresse leads sendes til (uden denne mailes der ikke, kun gemmes).
LEAD_EMAIL_TO=kontakt@karltoffel.dk
LEAD_EMAIL_FROM=tilbud@karltoffel.dk

# SMTP (valgfrit) - uden SMTP_HOST logges mails som JSON i stedet for at sendes.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# WorkMaker CRM (endnu ubekraeftet API) ---------------------------------
# Naar det skrivbare lead/tilbud-API er bekraeftet, saet disse - saa aktiveres
# adapteren automatisk. Uden dem gemmes+mailes leads stadig.
WORKMAKER_API_URL=
WORKMAKER_API_KEY=

# Rate limit for /api/lead
RATE_WINDOW_MS=600000
RATE_MAX=5
